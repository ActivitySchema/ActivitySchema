---
import "../styles/global.css";
import LogoMark from "../components/LogoMark.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = Astro.url.pathname } = Astro.props;
const canonical = new URL(path, Astro.site);
const nav = [
  { href: "/activities/", label: "The model" },
  { href: "/efficiency/", label: "Efficiency" },
  { href: "/ai/", label: "For AI" },
  { href: "/global-standard/", label: "The future" },
  { href: "/mission/", label: "About" },
];
const guideNav = [
  { href: "/activities/", label: "Activities" },
  { href: "/temporal-joins/", label: "Temporal joins" },
  { href: "/efficiency/", label: "Efficiency" },
  { href: "/dimensions/", label: "Dimensions and joins" },
  { href: "/ai/", label: "Activity Schema for AI" },
  { href: "/global-standard/", label: "A global activity standard" },
  { href: "/mission/", label: "Mission and creator" },
];
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f6f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Activity Schema" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-site-header>
      <div class="shell nav-row">
        <a class="brand" href="/" aria-label="Activity Schema home">
          <LogoMark size={34} />
          <span>Activity Schema</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
          <a class="nav-spec" href="https://github.com/ActivitySchema/ActivitySchema/blob/main/2.0.md">
            Read the spec <span aria-hidden="true">↗</span>
          </a>
        </nav>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu">
          <span>Menu</span>
          <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" /></svg>
        </button>
      </div>
      <div class="mobile-menu" id="mobile-menu" hidden>
        <nav class="shell mobile-nav" aria-label="Mobile navigation">
          {guideNav.map((item, index) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              <span class="mono">{String(index + 1).padStart(2, "0")}</span>{item.label}
            </a>
          ))}
          <a class="mobile-spec" href="https://github.com/ActivitySchema/ActivitySchema/blob/main/2.0.md">Read specification 2.0 <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-intro">
          <a class="brand footer-brand" href="/"><LogoMark size={38} /><span>Activity Schema</span></a>
          <p>An open standard for modeling business activity over time.</p>
        </div>
        <div>
          <p class="footer-label">Learn</p>
          <a href="/activities/">Activities</a>
          <a href="/temporal-joins/">Temporal joins</a>
          <a href="/efficiency/">Efficiency</a>
          <a href="/dimensions/">Dimensions and joins</a>
          <a href="/ai/">For AI</a>
        </div>
        <div>
          <p class="footer-label">Build</p>
          <a href="https://github.com/ActivitySchema/ActivitySchema/blob/main/2.0.md">Specification 2.0</a>
          <a href="https://github.com/ActivitySchema/ActivitySchema/blob/main/implementation.md">Implementation guide</a>
          <a href="https://github.com/ActivitySchema/ActivitySchema">GitHub repository</a>
        </div>
        <div>
          <p class="footer-label">Connect</p>
          <a href="/global-standard/">The global standard</a>
          <a href="mailto:ahmed@polyform.ai?subject=Activity%20Schema%20project">Share your project</a>
          <a href="https://www.linkedin.com/in/elsamadisi/">Ahmed on LinkedIn</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>Apache 2.0 licensed</span>
        <span>Created by Ahmed Elsamadisi</span>
      </div>
    </footer>
    <script>
      const header = document.querySelector("[data-site-header]");
      const button = header?.querySelector(".menu-button");
      const menu = header?.querySelector(".mobile-menu");

      const closeMenu = () => {
        if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
        button.setAttribute("aria-expanded", "false");
        menu.hidden = true;
        document.body.classList.remove("menu-open");
      };

      if (button instanceof HTMLButtonElement && menu instanceof HTMLElement) {
        button.addEventListener("click", () => {
          const opening = button.getAttribute("aria-expanded") !== "true";
          button.setAttribute("aria-expanded", String(opening));
          menu.hidden = !opening;
          document.body.classList.toggle("menu-open", opening);
        });
        menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeMenu();
            button.focus();
          }
        });
        window.matchMedia("(min-width: 901px)").addEventListener("change", closeMenu);
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: rgba(246, 246, 248, 0.96);
    backdrop-filter: blur(12px);
  }

  .nav-row {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 10px;
    color: var(--navy);
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1px;
  }

  .desktop-nav a {
    padding: 10px;
    color: var(--slate);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-underline-offset: 7px;
  }

  .desktop-nav .nav-spec {
    margin-left: 8px;
    padding-inline: 15px;
    background: var(--navy);
    color: var(--white);
  }

  .desktop-nav .nav-spec:hover {
    background: var(--midnight);
    color: var(--white);
    text-decoration: none;
  }

  .menu-button,
  .mobile-menu {
    display: none;
  }

  .site-footer {
    padding-block: 72px 28px;
    background: var(--midnight);
    color: var(--white);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(240px, 1.7fr) repeat(3, 1fr);
    gap: 48px;
  }

  .site-footer p,
  .site-footer a {
    color: rgba(255, 255, 255, 0.68);
  }

  .site-footer a {
    display: block;
    width: fit-content;
    margin-bottom: 11px;
    font-size: 0.88rem;
    text-decoration: none;
  }

  .site-footer a:hover { color: var(--white); }

  .site-footer .footer-brand {
    margin-bottom: 18px;
    color: var(--white);
    font-size: 1.12rem;
  }

  .site-footer .footer-brand :global(.logo-mark) { color: var(--white); }

  .footer-intro p { max-width: 270px; }

  .site-footer .footer-label {
    margin-bottom: 18px;
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 64px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.78rem;
  }

  @media (max-width: 1040px) {
    .desktop-nav a { padding-inline: 7px; }
    .desktop-nav .nav-spec { display: none; }
  }

  @media (max-width: 900px) {
    .nav-row { min-height: 64px; }
    .desktop-nav { display: none; }
    .menu-button {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 9px 0 9px 12px;
      border: 0;
      background: transparent;
      color: var(--navy);
      font: inherit;
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
    }
    .menu-button svg { width: 18px; height: 18px; }
    .menu-button path { fill: none; stroke: currentColor; stroke-width: 1.5; }
    .menu-button[aria-expanded="true"] path:first-child { transform: translateY(4px) rotate(45deg); transform-origin: center; }
    .menu-button[aria-expanded="true"] path:last-child { transform: translateY(-4px) rotate(-45deg); transform-origin: center; }
    .mobile-menu {
      position: fixed;
      z-index: 1;
      top: 64px;
      right: 0;
      left: 0;
      display: block;
      height: calc(100dvh - 64px);
      overflow-y: auto;
      border-top: 1px solid var(--line);
      background: var(--canvas);
    }
    .mobile-menu[hidden] { display: none; }
    .mobile-nav { display: grid; padding-block: 20px 36px; }
    .mobile-nav a {
      display: grid;
      grid-template-columns: 34px 1fr;
      gap: 12px;
      padding-block: 15px;
      border-bottom: 1px solid var(--line);
      color: var(--navy);
      font-size: clamp(1.05rem, 5vw, 1.35rem);
      font-weight: 550;
      text-decoration: none;
    }
    .mobile-nav a[aria-current="page"] { border-bottom-color: var(--orange); }
    .mobile-nav .mono { padding-top: 4px; color: var(--steel); font-size: 0.62rem; font-weight: 400; }
    .mobile-nav .mobile-spec {
      display: flex;
      justify-content: space-between;
      margin-top: 22px;
      padding: 15px;
      border: 0;
      background: var(--navy);
      color: var(--white);
      font-size: 0.9rem;
    }
    :global(body.menu-open) { overflow: hidden; }
    .footer-grid { grid-template-columns: 1.4fr 1fr 1fr; }
    .footer-intro { grid-column: 1 / -1; }
  }

  @media (max-width: 620px) {
    .brand span { font-size: 0.95rem; }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px 24px; }
    .footer-intro { grid-column: 1 / -1; }
    .footer-bottom { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>
