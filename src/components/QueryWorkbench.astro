---
const examples = [
  {
    id: "conversion",
    label: "Conversion",
    question: "Which email most often leads to a completed order?",
    cohort: "completed_order",
    append: "opened_email",
    relationship: "last before",
    result: "Group completed orders by the last email each customer opened before ordering.",
  },
  {
    id: "retention",
    label: "Retention",
    question: "What did retained customers do before renewing?",
    cohort: "renewed_subscription",
    append: "product_activity",
    relationship: "aggregate in before",
    result: "Summarize product activity before each renewal, without changing the cohort rows.",
  },
  {
    id: "operations",
    label: "Operations",
    question: "Where do orders wait longest before shipment?",
    cohort: "completed_order",
    append: "shipped_order",
    relationship: "first after",
    result: "Measure elapsed time from every completed order to its next shipment activity.",
  },
];
---

<div class="workbench" data-workbench>
  <div class="workbench-topbar">
    <span class="mono">AI query plan</span>
    <span class="ready"><i></i> grounded in activities</span>
  </div>
  <div class="workbench-body">
    <div class="example-tabs" role="group" aria-label="Choose an example business question">
      {
        examples.map((example, index) => (
          <button
            type="button"
            data-example={example.id}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {example.label}
          </button>
        ))
      }
    </div>
    <p class="prompt" data-question>{examples[0].question}</p>
    <div class="plan" aria-live="polite">
      <div class="plan-step">
        <span class="step-number">01</span>
        <span class="step-label">Start with</span>
        <code data-cohort>{examples[0].cohort}</code>
      </div>
      <div class="connector" aria-hidden="true"><span></span><b>then</b><span></span></div>
      <div class="plan-step">
        <span class="step-number">02</span>
        <span class="step-label">Append</span>
        <code data-append>{examples[0].append}</code>
      </div>
      <div class="connector" aria-hidden="true"><span></span><b>using</b><span></span></div>
      <div class="plan-step relationship-step">
        <span class="step-number">03</span>
        <span class="step-label">Relationship</span>
        <code data-relationship>{examples[0].relationship}</code>
      </div>
    </div>
    <div class="result">
      <span class="result-label">Result</span>
      <p data-result>{examples[0].result}</p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ examples }}>
  const root = document.querySelector("[data-workbench]");

  if (root) {
    const fields = {
      question: root.querySelector("[data-question]"),
      cohort: root.querySelector("[data-cohort]"),
      append: root.querySelector("[data-append]"),
      relationship: root.querySelector("[data-relationship]"),
      result: root.querySelector("[data-result]"),
    };

    root.querySelectorAll("[data-example]").forEach((button) => {
      button.addEventListener("click", () => {
        const selected = examples.find((example) => example.id === button.dataset.example);
        if (!selected) return;

        root.querySelectorAll("[data-example]").forEach((item) => {
          item.setAttribute("aria-pressed", String(item === button));
        });

        Object.entries(fields).forEach(([key, element]) => {
          if (element) element.textContent = selected[key];
        });
      });
    });
  }
</script>

<style>
  .workbench {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--midnight);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--white);
  }

  .workbench-topbar {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    padding-inline: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.72rem;
  }

  .ready {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--seafoam-light);
  }

  .ready i {
    width: 6px;
    height: 6px;
    background: var(--seafoam);
  }

  .workbench-body {
    padding: clamp(20px, 4vw, 36px);
  }

  .example-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  button {
    min-height: 34px;
    padding: 7px 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.66);
    cursor: pointer;
    font: inherit;
    font-size: 0.75rem;
  }

  button[aria-pressed="true"] {
    border-color: var(--seafoam);
    background: rgba(68, 180, 139, 0.12);
    color: var(--seafoam-light);
  }

  .prompt {
    max-width: 720px;
    margin-bottom: 36px;
    color: var(--white);
    font-size: clamp(1.45rem, 3vw, 2.25rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .plan {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 12px;
  }

  .plan-step {
    display: grid;
    min-height: 126px;
    align-content: space-between;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.04);
  }

  .relationship-step {
    background: rgba(68, 180, 139, 0.09);
  }

  .step-number,
  .step-label,
  .result-label {
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.63rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .step-number {
    justify-self: end;
  }

  .plan code {
    overflow-wrap: anywhere;
    color: var(--seafoam-light);
    font-size: 0.75rem;
  }

  .connector {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
  }

  .connector span {
    width: 1px;
    height: 24px;
    background: rgba(255, 255, 255, 0.14);
  }

  .connector b {
    color: rgba(255, 255, 255, 0.32);
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .result {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 20px;
    margin-top: 20px;
    padding: 18px;
    border-left: 2px solid var(--seafoam);
    background: rgba(255, 255, 255, 0.04);
  }

  .result p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.87rem;
  }

  @media (max-width: 780px) {
    .plan {
      grid-template-columns: 1fr;
    }

    .connector {
      height: 26px;
      flex-direction: row;
    }

    .connector span {
      width: 32px;
      height: 1px;
    }

    .connector b {
      writing-mode: initial;
    }
  }
</style>
